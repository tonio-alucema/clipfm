# Copy to .env.local and fill in from the Supabase project settings.
# .env.local is gitignored; verify that before your first commit.

# Client-safe. Inlined into the browser bundle at build time, and set in
# Vercel's environment for deploys.
#
# In newer Supabase projects this is the "publishable" key (sb_publishable_...).
# Older projects call it "anon". Same thing; the variable name follows the
# working agreements rather than the dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LOCAL ONLY. Used by scripts/seed.mjs and nothing else. Never put this in app
# code, and never add it to Vercel.
#
# The "secret" key (sb_secret_...) in newer projects, "service_role" in older
# ones. It bypasses RLS entirely, which is exactly why it stays on one machine.
SUPABASE_SERVICE_ROLE_KEY=
