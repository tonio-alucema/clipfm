# Copy to .env.local and fill in from the Supabase project settings.
# .env.local is gitignored; verify that before your first commit.

# Client-safe. Inlined into the browser bundle at build time, and set in
# Vercel's environment for deploys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LOCAL ONLY. Used by scripts/seed.mjs and nothing else. Never put this in app
# code, and never add it to Vercel.
SUPABASE_SERVICE_ROLE_KEY=
