    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4.3.3",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "next": "^16.3.3",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  }
